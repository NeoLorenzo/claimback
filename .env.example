# Copy these into .env (which is gitignored) and fill them in.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Dedicated ClaimBack Gmail: turn on 2-Step Verification, then create an app password
CLAIMBACK_EMAIL=
CLAIMBACK_EMAIL_APP_PASSWORD=

# Optional second account that plays the simulated insurer in the recording
INSURER_SIM_EMAIL=
INSURER_SIM_APP_PASSWORD=
